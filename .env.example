# All application paths are relative to the repository root.
RAGGLASS_DATA_DIR=.data
HF_HOME=.cache/huggingface
TORCH_HOME=.cache/torch
DOCLING_CACHE_DIR=.cache/docling
# Set DOCLING_ARTIFACTS_PATH only if you have pre-downloaded ALL Docling artifacts.

# Reuse an independent model HTTP service. No model server is started by the app.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma4:e4b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=768
LLM_CONTEXT_TOKENS=8192
LLM_KEEP_ALIVE=5m
LLM_THINK=false
# OpenAI-compatible alternative (vLLM, etc.):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_MODEL=your-served-model-name
# LLM_JSON_MODE=true

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_DEVICE=cpu
CPU_THREADS=4
CHUNK_TOKENS=240
CHUNK_OVERLAP_TOKENS=32
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.70
MAX_UPLOAD_MB=30
MAX_PDF_PAGES=200
