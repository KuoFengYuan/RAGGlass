[Unit]
Description=RAGGlass document RAG workbench
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/repo/RAGGlass
ExecStart=%h/repo/RAGGlass/.venv/bin/python -m uvicorn ragglass.main:app --app-dir backend --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
